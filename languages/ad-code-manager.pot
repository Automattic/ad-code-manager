#: src/UI/class-contextual-help.php:144
msgid "Your AdSense Publisher ID. This starts with \"ca-pub-\" followed by a 16-digit number."
msgstr ""

#: src/UI/class-contextual-help.php:146
msgid "Example: ca-pub-1234567890123456"
msgstr ""

#: src/UI/class-contextual-help.php:148
msgid "Find it in your AdSense account: <i>Account &gt; Account Information &gt; Publisher ID</i>."
